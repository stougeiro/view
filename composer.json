{
    "name": "stougeiro/view",
    "description": "A light, engine-agnostic view layer for PHP. It resolves view identifiers (dot notation and aliases) into file paths, merges shared and local data, and renders templates through a swappable engine. No global helpers, no hidden state, no cache: pure dependency injection.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "view",
        "template",
        "template-engine",
        "template-inheritance",
        "escaping",
        "rendering",
        "view-engine",
        "view-manager",
        "php-template"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/view/issues",
        "source": "https://github.com/stougeiro/view"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\View\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/view-contract": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest",
        "perf": "vendor/bin/pest --testsuite=Performance"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
